# ==============================================================================
# Bluesky 账号配置 (用于发布到 bsky.app)
# 请在 bsky.app 后台生成 App Password (应用专用密码)，无需使用主密码
# 路径：Settings -> Privacy and security -> App Passwords -> Add App Password
# ==============================================================================
BSKY_HANDLE=your-handle.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 可选：PDS 服务地址，默认官方 https://bsky.social
BSKY_SERVICE_URL=https://bsky.social

# 目标推广官网基地址
HSYL_BASE_URL=https://www.hsylkitchen.com

# 运行模式：设置为 true 时只生成内容和测试卡片，不向 Bluesky API 发送真实请求
DRY_RUN=false
